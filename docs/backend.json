
{
  "entities": {
    "UserProfile": {
      "title": "Profil Utilisateur",
      "description": "Données spécifiques à l'utilisateur et rôles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["uid", "email"]
    },
    "Product": {
      "title": "Produit",
      "description": "Annonce d'un produit dans la marketplace.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "basePrice": { "type": "number" },
        "condition": { "type": "string", "enum": ["new", "used", "refurbished"] },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "sellerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "sold", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "basePrice", "sellerId", "status"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "Les utilisateurs peuvent lire et écrire leur propre profil. L'admin peut tout lire."
    },
    "/products/{productId}": {
      "schema": "#/backend/entities/Product",
      "description": "Tout le monde peut lire les produits actifs. Les utilisateurs connectés peuvent créer des produits. Les propriétaires peuvent modifier leurs produits. L'admin peut tout modifier (validation)."
    }
  }
}
