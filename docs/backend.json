
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Un article mis en vente sur SalleDeVente.sn.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Le titre du produit" },
        "description": { "type": "string", "description": "Description détaillée" },
        "basePrice": { "type": "number", "description": "Prix de base" },
        "category": { "type": "string", "description": "ID de la catégorie" },
        "condition": { "type": "string", "description": "État de l'article" },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "description": "Statut (active, pending, etc.)" },
        "createdAt": { "type": "object" },
        "sellerId": { "type": "string" }
      },
      "required": ["title", "basePrice", "category", "condition", "status"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "PUBLIC ACCESS: Anyone can read, list, and create. allow read, list, create: if true;"
    }
  }
}
