
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An item listed for sale on the marketplace.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the product" },
        "description": { "type": "string", "description": "Full description of the item" },
        "basePrice": { "type": "number", "description": "Price before commission" },
        "category": { "type": "string", "description": "Product category ID" },
        "condition": { "type": "string", "enum": ["new", "used", "refurbished"] },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "pending", "rejected", "sold"] },
        "createdAt": { "type": "object" },
        "sellerId": { "type": "string" }
      },
      "required": ["title", "basePrice", "category", "condition", "status"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public access: Anyone can read and create products to facilitate step-by-step testing."
    }
  }
}
