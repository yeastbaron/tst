
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Essential user account data for SalleDeVente.sn.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "CompleteName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Product": {
      "title": "Marketplace Product",
      "description": "Product listing for the marketplace.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "basePrice": { "type": "number" },
        "condition": { "type": "string", "enum": ["new", "used", "refurbished"] },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "sellerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "rejected", "sold"] },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "basePrice", "sellerId", "status"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "User profiles access. READ: Any authenticated user. WRITE: Owner or admin ndaw22@gmail.com."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Marketplace ads. READ: Public. CREATE: Authenticated user. UPDATE/DELETE: Seller or admin ndaw22@gmail.com."
    }
  }
}
