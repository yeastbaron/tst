
{
  "entities": {
    "UserProfile": {
      "title": "Profil Utilisateur",
      "description": "Données de compte des utilisateurs enregistrées dans Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "CompleteName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Product": {
      "title": "Produit",
      "description": "Annonce de produit déposée par un vendeur.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "basePrice": { "type": "number" },
        "condition": { "type": "string", "enum": ["new", "used", "refurbished"] },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "sellerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "rejected", "sold"] },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "basePrice", "sellerId", "status"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profile access. Read: any authenticated user. Write: owner (request.auth.uid == userId) or admin (ndaw22@gmail.com)."
    },
    "/products/{productId}": {
      "schema": "#/backend/entities/Product",
      "description": "Product listings. Read: anyone. Write: any authenticated user."
    }
  }
}
